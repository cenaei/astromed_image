# PostgreSQL (used by docker-compose.yml for the db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-db-password
POSTGRES_DB=astromed

# Optional: override host-bound ports
# POSTGRES_PORT=5438
# WEB_PORT=3000

# Auth — generate a strong random value on the server:
#   openssl rand -hex 32
AUTH_SECRET=change-me-to-a-random-secret
NUXT_OG_IMAGE_SECRET=change-me-to-a-random-secret

# Public site URL (set to your real domain / server IP)
SITE_URL=https://your-domain.com
# AUTH_ORIGIN=https://your-domain.com

# SMTP for sending emails (contact forms, product documents)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Recipient for contact-form submissions
NUXT_MAIL_MESSAGE_TO=info@astromed-co.com
