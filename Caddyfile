# Caddy v2 site config for AstroMed — PLAIN HTTP origin behind Arvan CDN.
#
# IMPORTANT: Arvan Cloud terminates TLS at its edge (Free SSL) and points its
# origin to this server over HTTP on port 80. Therefore Caddy runs on plain
# HTTP and does NOT request Let's Encrypt certificates (cert issuance would
# fail through the proxy anyway). Do NOT change this to a bare hostname or
# Caddy will try to enable automatic HTTPS.
#
# Replace YOUR_DOMAIN with your real domain before running Caddy.
#
# Usage:
#   sudo caddy run --config Caddyfile            (first run)
#   sudo systemctl enable --now caddy            (persistent)
#   sudo cp /srv/astromed/Caddyfile /etc/caddy/Caddyfile   (systemd service)

http://YOUR_DOMAIN {
	encode gzip
	reverse_proxy 127.0.0.1:3000

	# Cache HEADERS only for hashed static assets. The actual caching decision
	# (TTL, purge) is configured in the Arvan panel — HTML must NOT be cached.
	@static path *.js *.css *.svg *.png *.jpg *.jpeg *.gif *.webp *.avif *.ico
	header @static Cache-Control "public, max-age=31536000, immutable"
}