# PostgreSQL connection string (see docker-compose.yml for local defaults)
DATABASE_URL="postgresql://postgres:postgres@localhost:5438/astromed?schema=public"

# Auth — generate a strong random value in production
AUTH_SECRET="change-me-to-a-random-secret"
AUTH_ORIGIN="http://localhost:5500"

# SMTP for sending emails (contact forms, product documents)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Recipient for contact-form submissions
NUXT_MAIL_MESSAGE_TO="info@astromed-co.com"

# Public site URL (used for SEO)
SITE_URL="http://localhost:5500"

# Secret for OpenGraph image generation
NUXT_OG_IMAGE_SECRET="change-me-to-a-random-secret"
